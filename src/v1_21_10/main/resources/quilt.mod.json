{
  "schema_version": 1,
  "quilt_loader": {
    "group": "net.fentbusgaming",
    "id": "localweather",
    "version": "${version}",
    "metadata": {
      "name": "Localized Weather",
      "description": "Weather happens per 256x256 zone instead of world-wide: rain, snow, hail and thunderstorms run on their own schedules, biome rules decide what falls, and moving single-cell thunderstorms drift along the wind carrying a rain wall and trailing rain bands. Zone edges blend, so you can stand in sunshine and watch a storm roll in over the hills.",
      "contributors": {
        "fentbusgaming": "Owner"
      },
      "contact": {
        "homepage": "https://modrinth.com/mod/localizedweather",
        "sources": "https://github.com/rustybusgaming/LocalizedWeather",
        "issues": "https://github.com/rustybusgaming/LocalizedWeather/issues"
      },
      "license": "MIT",
      "icon": "assets/localweather/icon.png"
    },
    "entrypoints": {
      "init": "net.fentbusgaming.localweather.LocalWeatherMod",
      "client_init": "net.fentbusgaming.localweather.LocalWeatherClient"
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=${loader_version}"
      },
      {
        "id": "minecraft",
        "versions": "${minecraft_dependency}"
      },
      {
        "id": "fabric-api",
        "versions": "*"
      },
      {
        "id": "modmenu",
        "versions": "*",
        "optional": true
      }
    ],
    "intermediate_mappings": "net.fabricmc:intermediary"
  },
  "mixin": [
    "localweather.mixins.json",
    "localweather.client.mixins.json"
  ]
}